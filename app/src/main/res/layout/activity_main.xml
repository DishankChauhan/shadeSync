<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.shadesync.app.FaceMeshOverlayView
        android:id="@+id/faceMeshOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-right action buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCapture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="@drawable/toggle_bg"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Capture photo"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="@drawable/toggle_bg"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Share photo"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom controls container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:background="@drawable/bottom_bar_bg">

        <!-- Brightness slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="14sp"
                android:textColor="#90FFFFFF" />

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="150"
                android:progress="70"
                android:progressTint="#FFFFFFFF"
                android:thumbTint="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="20sp"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>

        <!-- Finish + Tone toggle row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="18dp">

        <!-- Finish toggle (Matte / Glossy) -->
        <LinearLayout
            android:id="@+id/finishToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/toggle_bg"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnMatte"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:gravity="center"
                android:text="MATTE"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnGlossy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:gravity="center"
                android:text="GLOSSY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/toggle_selected_bg" />

        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Tone toggle (Cool / Warm) -->
        <LinearLayout
            android:id="@+id/toneToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/toggle_bg"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnCool"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="COOL"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnNeutral"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:text="●"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/toggle_selected_bg" />

            <TextView
                android:id="@+id/btnWarm"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="WARM"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

        </LinearLayout>

        </LinearLayout>

        <!-- Shade name + brand label -->
        <TextView
            android:id="@+id/shadeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cherry Crush"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/shadeBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShadeSync"
            android:textColor="#90FFFFFF"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <!-- Brand filter chips (horizontal scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/brandChipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Search bar + HEX input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/toggle_bg"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/shadeSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search shade, brand, or #HEX..."
                android:textColorHint="#60FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Dynamic shade swatches (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shadeRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp"
            android:paddingTop="4dp"
            android:clipToPadding="false" />

    </LinearLayout>

</FrameLayout>
