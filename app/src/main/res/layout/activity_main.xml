<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.shadesync.app.LipGLSurfaceView
        android:id="@+id/lipGLView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.shadesync.app.FaceMeshOverlayView
        android:id="@+id/faceMeshOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-left: Analyze Me button -->
    <TextView
        android:id="@+id/btnAnalyze"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/analyze_btn_bg"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="✨ Analyze Me"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04" />

    <!-- Recommendation overlay card (hidden by default) -->
    <LinearLayout
        android:id="@+id/recommendationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:background="@drawable/recommendation_card_bg"
        android:padding="18dp"
        android:visibility="gone"
        android:elevation="8dp">

        <!-- Close button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Skin Analysis"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnCloseRec"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#90FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/toggle_bg" />

        </LinearLayout>

        <!-- Skin tone + undertone result -->
        <TextView
            android:id="@+id/skinAnalysisResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyzing..."
            android:textColor="#E0FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <!-- Skin colour swatch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/skinSwatch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/toggle_bg" />

            <TextView
                android:id="@+id/skinHexLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#000000"
                android:textColor="#90FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/confidenceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence: 85%"
                android:textColor="#90FFFFFF"
                android:textSize="11sp"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- "Best for you" label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ Recommended shades for you"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <!-- Recommendation RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:clipToPadding="false" />

        <!-- "Apply Top Pick" button -->
        <TextView
            android:id="@+id/btnApplyTopPick"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/analyze_btn_bg"
            android:gravity="center"
            android:text="💄 Apply Top Pick"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Top-right action buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCapture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="@drawable/toggle_bg"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Capture photo"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_share"
            android:background="@drawable/toggle_bg"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="Share photo"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom controls container -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="52dp"
        android:background="@drawable/bottom_bar_bg">

        <!-- Drag handle / toggle button -->
        <LinearLayout
            android:id="@+id/panelHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Visual handle bar -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/toggle_bg" />

            <!-- Chevron indicator -->
            <TextView
                android:id="@+id/panelChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#70FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Collapsible content wrapper -->
        <LinearLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <!-- Look Presets toggle row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/btnShowPresets"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="💅 Looks"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/analyze_btn_bg" />

            <TextView
                android:id="@+id/btnShowShades"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="8dp"
                android:text="💄 Shades"
                android:textColor="#90FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/toggle_bg" />

            <TextView
                android:id="@+id/activePresetLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#B0FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

        </LinearLayout>

        <!-- Preset picker (horizontal scroll, hidden by default) -->
        <HorizontalScrollView
            android:id="@+id/presetScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </HorizontalScrollView>

        <!-- Shades panel (shown by default) -->
        <LinearLayout
            android:id="@+id/shadesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <!-- Brightness slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="14sp"
                android:textColor="#90FFFFFF" />

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="150"
                android:progress="70"
                android:progressTint="#FFFFFFFF"
                android:thumbTint="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textSize="20sp"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>

        <!-- Finish + Tone toggle row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="18dp">

        <!-- Finish toggle (Matte / Glossy) -->
        <LinearLayout
            android:id="@+id/finishToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/toggle_bg"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnMatte"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:gravity="center"
                android:text="MATTE"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnGlossy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:gravity="center"
                android:text="GLOSSY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/toggle_selected_bg" />

        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Tone toggle (Cool / Warm) -->
        <LinearLayout
            android:id="@+id/toneToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="@drawable/toggle_bg"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnCool"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="COOL"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/btnNeutral"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:text="●"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/toggle_selected_bg" />

            <TextView
                android:id="@+id/btnWarm"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="WARM"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />

        </LinearLayout>

        </LinearLayout>

        <!-- Shade name + brand label -->
        <TextView
            android:id="@+id/shadeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cherry Crush"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/shadeBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ShadeSync"
            android:textColor="#90FFFFFF"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <!-- Brand filter chips (horizontal scroll) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/brandChipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Search bar + HEX input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/toggle_bg"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/shadeSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search shade, brand, or #HEX..."
                android:textColorHint="#60FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Dynamic shade swatches (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shadeRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp"
            android:paddingTop="4dp"
            android:clipToPadding="false" />

        </LinearLayout>  <!-- end shadesPanel -->

        </LinearLayout>  <!-- end panelContent -->

    </LinearLayout>

</FrameLayout>
